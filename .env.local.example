# Copy to .env.local and fill in. incident_loop.py reads this file on start.
# Secret key: Nango dashboard -> Environment settings -> API Keys
NANGO_SECRET_KEY=
# Connections page -> your GitHub connection -> Connection ID
NANGO_CONNECTION_ID=
# Integrations page -> GitHub -> unique key (often "github" or "github-getting-started")
NANGO_PROVIDER_KEY=github
GITHUB_REPO=abhijitbetigeri/robot-incident-analyst


# Lambda GPU instance running the reviewer model (Ollama). Public IP from cloud.lambda.ai -> Instances.
LAMBDA_HOST=
LAMBDA_SSH_KEY=~/.ssh/lambda.pem
LAMBDA_ENABLED=1
